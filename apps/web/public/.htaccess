# GoDaddy cPanel (Apache). Vite copies this file into dist/.
# Do not use `Options`: on this shared host it often returns 500.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# The hosting account injects a CSP (Firebase/Calendly/GoDaddy) that does not
# include the Railway API. Multiple CSP headers are AND-ed by the browser, so
# we must unset the inherited one and set ours.
<IfModule mod_headers.c>
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://img1.wsimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://agendya-dev.up.railway.app https://agendya-api.up.railway.app https://api.agendya.co https://launch.agendya.co https://csp.secureserver.net; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # Vite writes every JS/CSS asset under /assets/ with a content hash in the
  # filename, so a given URL's bytes never change — cache them hard and skip
  # revalidation on repeat views. index.html must NOT be cached this way or a
  # deploy won't be picked up: it always revalidates.
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Compress text responses the host doesn't already gzip (SVG, fonts, JSON,
# source maps). No-op for types the platform compression already covers.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml font/ttf font/otf
</IfModule>
