# Leave unset to auto-detect (uses the same host the page was loaded from, so it
# works both on localhost and over the LAN via `npm run dev:web:host`).
# Set explicitly only to point at a different backend (e.g. staging).
# VITE_API_URL=http://localhost:4000
#
# Hosted builds (GitHub Actions sets this):
#   app-dev.agendya.co  →  https://agendya-dev.up.railway.app
#   app.agendya.co      →  https://api.agendya.co
