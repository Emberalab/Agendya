# Same Postgres instance as apps/api — InternalUser/SupportTicket/AuditLog
# live in the same database as Professional/Booking (real FKs cross that
# boundary). This is a separate deployable service, not a separate database.
DATABASE_URL="postgresql://agendya:agendya_dev_password@localhost:5433/agendya_dev?schema=public"

# Deliberately its own secret, distinct from apps/api's JWT_SECRET — see
# src/config/configuration.ts for why. Generate a real one before deploying:
# openssl rand -base64 48
JWT_SECRET="dev-backoffice-secret-change-in-production"
JWT_EXPIRES_IN="7d"

PORT="4001"

# Origin of apps/backoffice-web, for CORS. Prod: https://backoffice.agendya.co
BACKOFFICE_WEB_URL="http://localhost:5174"

# Google sign-in for staff (optional). Create a separate OAuth client from
# apps/api's, with this authorized redirect URI. Google sign-in only links to
# an existing, active staff account with the same verified email — it never
# creates accounts. Leave the id/secret empty to disable the button's flow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4001/backoffice/auth/google/callback"
# Optional comma-separated allowlist of Google email domains, e.g. "agendya.co".
GOOGLE_ALLOWED_DOMAINS=""

# Password recovery emails. Without a key, emails are only logged (dev).
RESEND_API_KEY=""
MAIL_FROM="Agendya Backoffice <no-reply@agendya.co>"
MAIL_REPLY_TO="info@agendya.co"
