# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://agendya:agendya_dev_password@localhost:5433/agendya_dev?schema=public"
JWT_SECRET="dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"
SLOT_GRID_MINUTES="15"
RESEND_API_KEY=""
CLOUDINARY_URL=""
PORT="4000"
WEB_URL="http://localhost:5173"
# Public booking origin (prod: https://agendya.co). Leave empty when the
# dashboard and /:slug share one host (local and app-dev.agendya.co).
# PUBLIC_WEB_URL="https://agendya.co"

# Optional. Milliseconds between keep-alive frames on the real-time SSE stream
# (GET /realtime/stream). Lower it if a reverse proxy in front of the API drops
# idle connections sooner than the 25s default.
# REALTIME_HEARTBEAT_MS="25000"
