// Prisma schema — Agendya Fase 1 (MVP: Agenda Básica)
// Ver /Users/jorgeherrera/.claude/plans/dreamy-mixing-lark.md sección 1 para el razonamiento de diseño.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  // A CONFIRMED booking whose startAt has passed without being completed,
  // cancelled, or marked no-show. Set lazily (on-read, the instant a stale
  // booking is touched) and by ExpirationScheduler's periodic sweep so it
  // doesn't depend on the cron having run yet. See BookingsService.assertModifiable.
  EXPIRED
}

// Subscription tier (what the account pays for). Distinct from PlatformRole.
enum Plan {
  FREE
  BASIC
  ADVANCED
  BUSINESS
}

// Paid-period length written by Wompi checkout. Null on FREE or admin comps.
enum BillingInterval {
  monthly
  annual
}

enum PlatformRole {
  SUPER_ADMIN
  // Reserved: multi-location / business-owner accounts. Unused in Phase 1.
  BUSINESS_ADMIN
  INDEPENDENT
}

// Who may register/log in during closed beta, and who is SUPER_ADMIN.
// Source of truth lives here — not hardcoded emails in the API/web.
enum PlatformAccessKind {
  SUPER_ADMIN
  ALLOWLISTED
}

// In-app notification feed for a professional. Persisted so the dashboard's
// notification centre survives page reloads, offline periods, and missed
// real-time events. Real-time (SSE) delivery is a separate, best-effort channel
// layered on top; a future Web Push channel would be another. This row is the
// source of truth for all of them.
enum NotificationType {
  APPOINTMENT_CREATED
  // Reserved for later — only APPOINTMENT_CREATED is emitted today:
  // APPOINTMENT_CANCELLED, APPOINTMENT_RESCHEDULED, APPOINTMENT_REMINDER, SYSTEM
}

model Professional {
  id                      String       @id @default(uuid())
  email                   String       @unique
  passwordHash            String?
  googleId                String?      @unique
  businessName            String
  slug                    String       @unique
  category                String?
  photoUrl                String?
  logoUrl                 String?
  coverImageUrl           String?
  brandColor              String?      @default("#4F46E5")
  description             String?
  timezone                String       @default("America/Bogota")
  cancellationPolicyHours Int          @default(24)
  plan                    Plan              @default(FREE)
  billingInterval         BillingInterval?
  planStartedAt           DateTime?
  planExpiresAt           DateTime?
  lastWompiTransactionId  String?           @unique
  role                    PlatformRole      @default(INDEPENDENT)
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  services           Service[]
  workingHours       WorkingHour[]
  scheduleExceptions ScheduleException[]
  bookings           Booking[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  // Backoffice: this professional's support tickets. See SupportTicket.
  supportTickets     SupportTicket[]
  // Backoffice: messages this professional authored on their own tickets.
  // See SupportMessage.authorProfessionalId.
  authoredSupportMessages SupportMessage[]

  // `slug` and `googleId` are already `@unique`; the unique constraint's btree
  // index fully serves equality lookups and sorts on those columns, so no
  // secondary @@index is needed here.
}

model PlatformAccessEmail {
  id        String             @id @default(uuid())
  email     String             @unique
  access    PlatformAccessKind
  createdAt DateTime           @default(now())
}

model Service {
  id                  String       @id @default(uuid())
  professionalId      String
  professional        Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  durationMinutes     Int
  priceCents          Int          @default(0)
  isActive            Boolean      @default(true)
  homeServiceEnabled  Boolean      @default(false)
  homeDurationMinutes Int?
  homePriceCents      Int?
  sortOrder           Int          @default(0)
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  bookings Booking[]

  @@index([professionalId, isActive])
  @@index([professionalId, deletedAt])
}

model WorkingHour {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Weekday
  startMinute    Int
  endMinute      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, dayOfWeek])
}

model ScheduleException {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([professionalId, date])
}

model Booking {
  id                      String        @id @default(uuid())
  professionalId          String
  professional            Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId               String?
  service                 Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  customerName            String
  customerEmail           String
  customerPhone           String
  customerNote            String?
  atHome                  Boolean       @default(false)
  customerAddress         String?
  startAt                 DateTime
  endAt                   DateTime
  status                  BookingStatus @default(CONFIRMED)
  cancellationToken       String        @unique @default(uuid())
  cancelledAt             DateTime?
  cancelledBy             String?
  reminder24hSentAt       DateTime?
  reminder2hSentAt        DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Backoffice: tickets opened about this appointment. See SupportTicket.relatedBooking.
  supportTickets SupportTicket[]

  // Agenda list: professional's bookings within a date range, any status.
  @@index([professionalId, startAt])
  // Availability + overlap guard (createPublicBooking / reschedule): equality on
  // professionalId + status=CONFIRMED, range on startAt. Keeps the scan bounded
  // to live bookings instead of walking every past row for the professional.
  @@index([professionalId, status, startAt])
  // Global reminder / expiration sweeps: status + startAt, no professional filter.
  @@index([status, startAt])
  // FK column: Postgres does not auto-index it. Guards the SetNull path and any
  // "bookings for this service" lookup from a full table scan.
  @@index([serviceId])
}

model Notification {
  id             String           @id @default(uuid())
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           NotificationType
  // Rendered, ready-to-display strings — the source of truth for the in-app
  // feed and (later) a Web Push payload. Spanish-only, like the rest of the app.
  title          String
  body           String
  // Minimal navigation/display metadata, e.g.
  // { bookingId, customerName, serviceName, startAt }. Deliberately NOT a copy
  // of the whole booking — `bookingId` is the reference; the few extra fields
  // let the feed render without a join and are point-in-time by design (an
  // "appointment created" entry keeps reading as it did when it fired).
  data           Json
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  // The only list query: `WHERE professionalId = ? ORDER BY createdAt DESC`
  // (keyset-paginated on (createdAt, id)). Descending so the ORDER BY is a
  // forward index scan.
  @@index([professionalId, createdAt(sort: Desc)])
  // Unread badge: `WHERE professionalId = ? AND readAt IS NULL`. Prisma has no
  // declarative partial index; this composite still bounds the count/scan to
  // one professional's rows.
  @@index([professionalId, readAt])
}

// One browser Web Push subscription for a professional. The dashboard registers
// a service worker and, once the professional grants notification permission,
// POSTs the browser's `PushSubscription` here (see push.schema.ts). A
// professional with several devices/browsers has one row per endpoint.
//
// Web Push is a best-effort delivery channel for the `Notification` feed, never
// the source of truth: a push that fails (or a device that was offline) still
// leaves the row readable from `GET /notifications`.
model PushSubscription {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // The push service URL. Globally unique — the same browser re-subscribing
  // returns the same endpoint, so an upsert on this keeps one row per device.
  endpoint       String       @unique
  // Encryption material from `PushSubscription.toJSON().keys`, needed to sign
  // each payload for this subscription.
  p256dh         String
  auth           String
  // Best-effort provenance for the settings UI ("Chrome on Android"); not used
  // for delivery.
  userAgent      String?
  createdAt      DateTime     @default(now())
  // Bumped on each successful send; lets a future sweep prune stale endpoints
  // the push service never told us to drop.
  lastActiveAt   DateTime     @default(now())

  // Delivery loads every subscription for one professional.
  @@index([professionalId])
}

// =============================================================================
// Backoffice — internal operations & support (Fase 1 MVP)
//
// A deliberately separate identity system from `Professional`: Backoffice
// staff are the Agendya team, not barbers/stylists, so they get their own
// table + JWT + roles instead of overloading the customer-facing account
// model. See CLAUDE.md / the Backoffice plan for the full design rationale.
// =============================================================================

enum InternalRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  READ_ONLY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  APPOINTMENTS
  SCHEDULE
  AVAILABILITY
  NOTIFICATIONS
  ACCOUNT
  LOGIN
  PAYMENTS
  BUG
  PERFORMANCE
  OTHER
}

// CUSTOMER_VISIBLE messages are modeled now but have no delivery surface yet
// (no professional-facing ticket UI in this phase) — see Fase 2 in the plan.
// INTERNAL_NOTE messages must never be exposed to the professional.
enum MessageVisibility {
  CUSTOMER_VISIBLE
  INTERNAL_NOTE
}

enum AuditAction {
  SUPPORT_VIEWED_PROFESSIONAL
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED
  TICKET_MESSAGE_ADDED
  INTERNAL_USER_CREATED
  INTERNAL_USER_ROLE_CHANGED
  INTERNAL_USER_DEACTIVATED
}

model InternalUser {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  role         InternalRole @default(SUPPORT)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedTickets SupportTicket[]  @relation("TicketAssignee")
  messages        SupportMessage[]
  auditLogs       AuditLog[]
}

model SupportTicket {
  id                String         @id @default(uuid())
  professionalId    String
  professional      Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  subject           String
  category          TicketCategory
  priority          TicketPriority @default(NORMAL)
  status            TicketStatus   @default(OPEN)
  assignedToId      String?
  assignedTo        InternalUser?  @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Optional link to the appointment this ticket is about — powers the
  // ticket <-> appointment cross-navigation in the troubleshooting view.
  relatedBookingId  String?
  relatedBooking    Booking?       @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  messages SupportMessage[]

  // Ticket list, filtered/sorted by status + priority (the default queue view).
  @@index([status, priority])
  // A professional's 360° view: their open/resolved tickets.
  @@index([professionalId])
  // "My tickets" queue.
  @@index([assignedToId])
  // FK column: Postgres does not auto-index it.
  @@index([relatedBookingId])
}

model SupportMessage {
  id                   String            @id @default(uuid())
  ticketId             String
  ticket               SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Exactly one of authorInternalUserId / authorProfessionalId is set,
  // never both — enforced in the service layer (SupportService /
  // TicketsService), same as this schema's other cross-field invariants
  // (e.g. the self-assign rule). A message is either staff writing on a
  // ticket (visibility can be INTERNAL_NOTE or CUSTOMER_VISIBLE) or the
  // professional themselves (always CUSTOMER_VISIBLE).
  authorInternalUserId String?
  author               InternalUser?     @relation(fields: [authorInternalUserId], references: [id], onDelete: Restrict)
  authorProfessionalId String?
  authorProfessional   Professional?     @relation(fields: [authorProfessionalId], references: [id], onDelete: Cascade)
  visibility           MessageVisibility
  body                 String
  createdAt            DateTime          @default(now())

  // Ticket conversation thread, oldest first.
  @@index([ticketId, createdAt])
  // FK column: Postgres does not auto-index it.
  @@index([authorProfessionalId])
}

// Append-only: every mutating Backoffice action writes one row here. There is
// intentionally no update/delete path anywhere in the API for this model.
model AuditLog {
  id                  String       @id @default(uuid())
  actorInternalUserId String
  actor               InternalUser @relation(fields: [actorInternalUserId], references: [id], onDelete: Restrict)
  action              AuditAction
  entityType          String
  entityId            String
  // Safe, non-secret before/after context only — never tokens, password
  // hashes, or env/config values. Enforced by convention in AuditLogService
  // callers, not by the schema.
  metadata            Json?
  createdAt           DateTime     @default(now())

  // "What happened to this entity" timeline (e.g. one ticket's full history).
  @@index([entityType, entityId])
  // "What has this staff member done" timeline.
  @@index([actorInternalUserId, createdAt])
}
